{
  "name": "geodle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://geodle.me",
  "dependencies": {
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@react-router/dev": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "@tabler/icons-react": "^3.46.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "isbot": "^5.2.2",
    "js-cookie": "^3.0.8",
    "react": "^19.3.0",
    "react-confetti-blast": "^1.0.2",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "scripts": {
    "predeploy": "npm run build",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "typecheck": "react-router typegen && tsc",
    "start": "react-router dev",
    "dev": "react-router dev",
    "build": "react-router build",
    "postbuild": "node -e \"const f=require('fs'),b='build/client';try{f.copyFileSync(b+'/__spa-fallback.html',b+'/404.html')}catch{};for(const d of f.readdirSync(b))try{if(f.statSync(b+'/'+d).isDirectory())f.copyFileSync(b+'/'+d+'/index.html',b+'/'+d+'.html')}catch{}\"",
    "preview": "vite preview"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "country-json": "^2.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0"
  }
}
